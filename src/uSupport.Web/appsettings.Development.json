{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Global": {
        "Smtp": {
          "From": "usupport@localhost",
          "DeliveryMethod": "SpecifiedPickupDirectory",
          "PickupDirectoryLocation": "umbraco/Data/TEMP/MailPickup"
        }
      }
    }
  }
}

        "Id": "aba1da6a-8c01-44d6-92f5-1cfc3ebfa590",
        "SanitizeTinyMce": true,
        "UseHttps": true
      },
      "Content": {
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {

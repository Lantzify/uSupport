        "UnattendedTelemetryLevel": "Basic",
        "UnattendedUserEmail": "admin@admin.com",
        "UnattendedUserName": "Admin",
        "UnattendedUserPassword": "password123"
      },
      "Imaging": {
        "HMACSecretKey": "GQBhM2WBCgZfMa107bz1edI6jJIna\u002BdVpVCVBEvdRfYja74tWeVI83xj0eKPO4mSFqRn8F6/SOHDrOWUH6agWg=="
      }
    }
